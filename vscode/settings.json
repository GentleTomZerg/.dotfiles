{
  "files.autoSave": "onFocusChange",
  "editor.fontFamily": "'FiraCode Nerd Font', 'monospace'",
  "editor.fontSize": 16,
  "editor.fontVariations": false,
  "editor.formatOnSave": true,
  "window.menuBarVisibility": "visible",
  "window.titleBarStyle": "custom",
  "redhat.telemetry.enabled": true,
  "zenMode.centerLayout": false,
  "json.format.keepLines": true,
  /** Vscode Vim Configuration*/
  "vim.useSystemClipboard": true,
  "vim.leader": "<space>",
  "vim.easymotion": true,
  // Normal Mode
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["j"], "after": ["g", "j"] },
    { "before": ["k"], "after": ["g", "k"] },
    // Save
    { "before": ["<leader>", "w"], "after": [":", "w", "<cr>"] },
    // Quit
    { "before": ["<leader>", "q"], "after": [":", "q", "<cr>"] },
    { "before": ["<leader>", "c"], "after": [":", "q", "<cr>"] },
    // Comment
    { "before": ["<leader>", "/"], "commands": ["editor.action.commentLine"] },
    // Terminal
    {
      "before": ["<leader>", "t"],
      "commands": ["workbench.action.terminal.toggleTerminal"]
    },

    // File Explorer
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.explorer.fileView.focus"]
    },
    { "before": ["<leader>", "o"], "commands": ["revealInExplorer"] },
    // Switch Editor
    { "before": ["<S-h>"], "commands": ["workbench.action.previousEditor"] },
    { "before": ["<S-l>"], "commands": ["workbench.action.nextEditor"] },
    // Window Management
    { "before": ["<C-h>"], "after": ["<C-w>", "h"] },
    { "before": ["<C-j>"], "after": ["<C-w>", "j"] },
    { "before": ["<C-k>"], "after": ["<C-w>", "k"] },
    { "before": ["<C-l>"], "after": ["<C-w>", "l"] },
    { "before": ["<C-up>"], "after": ["<C-w>", "+"] },
    { "before": ["<C-down>"], "after": ["<C-w>", "-"] },
    { "before": ["<C-left>"], "after": ["<C-w>", "<"] },
    { "before": ["<C-right>"], "after": ["<C-w>", ">"] },
    // LSP
    { "before": ["K"], "commands": ["editor.action.showHover"] },
    {
      "before": ["<leader>", "l", "f"],
      "commands": ["editor.action.formatDocument"]
    },
    {
      "before": ["<leader>", "l", "a"],
      "commands": ["editor.action.quickFix"]
    },
    { "before": ["<leader>", "l", "r"], "commands": ["editor.action.rename"] },
    // - outline(大纲)
    { "before": ["<leader>", "l", "s"], "commands": ["outline.focus"] },
    { "before": ["g", "I"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
    // Git
    { "before": ["[", "g"], "commands": ["editor.action.dirtydiff.previous"] },
    { "before": ["]", "g"], "commands": ["editor.action.dirtydiff.next"] },
    // Find
    {
      "before": ["<leader>", "f", "w"],
      "commands": ["workbench.action.findInFiles"]
    },
    {
      "before": ["<leader>", "f", "o"],
      "commands": ["workbench.action.openRecent"]
    },
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    // UI
    {
      "before": ["<leader>", "u", "z"],
      "commands": ["workbench.action.toggleZenMode"]
    },
    {
      "before": ["<leader>", "u", "a"],
      "commands": ["workbench.action.toggleActivityBarVisibility"]
    },
    {
      "before": ["<leader>", "u", "s"],
      "commands": ["outline.toggleVisibility"]
    },
    {
      "before": ["<leader>", "u", "e"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    }
  ],
  // Insert Mode
  "vim.insertModeKeyBindingsNonRecursive": [
    // ESC

    { "before": ["j", "j"], "after": ["<esc>"] },
    { "before": ["j", "k"], "after": ["<esc>"] }
  ],
  // Visual Mode
  "vim.visualModeKeyBindingsNonRecursive": [
    // Comment
    { "before": ["<leader>", "/"], "commands": ["editor.action.commentLine"] }
  ],

  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "on",
      "strings": "on",
      "other": "on"
    },
    "editor.snippetSuggestions": "top",
    "cSpell.fixSpellingWithRenameProvider": true,
    "cSpell.advanced.feature.useReferenceProviderWithRename": true,
    "cSpell.advanced.feature.useReferenceProviderRemove": "/^#+\\s/"
  },
  "workbench.colorTheme": "Atom One Dark",
  "window.zoomLevel": 1,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },

  "vscode-neovim.compositeKeys": {
    "jj": {
      "command": "vscode-neovim.escape"
    }
  },
}
