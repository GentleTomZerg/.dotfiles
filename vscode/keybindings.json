// Place your key bindings in this file to override the defaults
[
    /**
    * NOTE: 
        1. when add keys start with <Space>, you must specify vim.active and editorTextFocus
        or space can not be entered since vscode will presume that you want to use a key binding
        rather than the space character

        2. key bindings start with <Space> only work when vim mode is active and the current tab is an editor
    */

    /*Insert Mode*/
    {
        "key": "alt+h",
        "command": "cursorLeft",
        "when": "editorTextFocus && vim.active && !inDebugRepl"
    },

    {
        "key": "alt+j",
        "command": "cursorDown",
        "when": "editorTextFocus && vim.active && !inDebugRepl"
    },


    {
        "key": "alt+k",
        "command": "cursorUp",
        "when": "editorTextFocus && vim.active && !inDebugRepl"
    },

    {
        "key": "alt+l",
        "command": "cursorRight",
        "when": "editorTextFocus && vim.active && !inDebugRepl"
    },

    /*Window Management*/
    {
        "key": "ctrl+h",
        "command": "workbench.action.focusLeftGroup",
        "when": "editorTextFocus && vim.active && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.focusRightGroup",
        "when": "editorTextFocus && vim.active && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.focusAboveGroup",
        "when": "editorTextFocus && vim.active && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.focusBelowGroup",
        "when": "editorTextFocus && vim.active && vim.mode != 'Insert'"
    },

    /*Nomal Mode*/
    // Save, Close and Quit
    {
        "key": "space w",
        "command": "workbench.action.files.save",
        "when": "editorTextFocus &&vim.active && vim.mode != 'Insert'"
    },
    {
        "key": "space c",
        "command": "workbench.action.closeActiveEditor",
        "when": "editorTextFocus &&vim.active && vim.mode != 'Insert'"
    },

    // Comment
    {
        "key": "space /",
        "command": "editor.action.commentLine",
        "when": "editorTextFocus &&vim.active && vim.mode != 'Insert'"
    },
    // Toggle Terminal
    {
        "key": "space t",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "terminalFocus || editorTextFocus &&vim.active && vim.mode != 'Insert'"
    },

    // Switch Buffer
    {
        "key": "shift+h",
        "command": "workbench.action.previousEditor",
        "when": "vim.active && vim.mode != 'Insert'"
    },

    {
        "key": "shift+l",
        "command": "workbench.action.nextEditor",
        "when": "vim.active && vim.mode != 'Insert'"
    },

    // File Explorer 
    {
        "key": "space e",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "filesExplorerFocus && vim.active && vim.mode != 'Insert'"
    },
    {
        "key": "space e",
        "command": "workbench.files.action.focusFilesExplorer",
        "when": "editorTextFocus && vim.mode != 'Insert'"
    },
    {
        "key": "a",
        "command": "explorer.newFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "r",
        "command": "renameFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "c",
        "command": "filesExplorer.copy",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "p",
        "command": "filesExplorer.paste",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "d",
        "command": "deleteFile",
        "when": "filesExplorerFocus && !inputFocus"
    }
]