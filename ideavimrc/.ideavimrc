"base
set showmode
set showcmd
"clipboard
set clipboard+=unnamed
set clipboard+=ideaput

"leader key
let mapleader=" "


"Terminal
nnoremap <leader>t :action Terminal.OpenInTerminal<CR>

"Window Navigation
sethandler <c-h> a:vim
sethandler <c-l> a:vim
sethandler <c-j> a:vim
sethandler <c-k> a:vim
" - switch windows
nnoremap <c-h> <c-w>h
nnoremap <c-l> <c-w>l
nnoremap <c-j> <c-w>j
nnoremap <c-k> <c-w>k

" - manipulate buffers(tabs)
nnoremap <leader>bp :action PreviousTab<CR>
nnoremap <leader>bn :action NextTab<CR>
nnoremap <leader>c :action CloseContent<CR>

"Which Key
set which-key
set notimeout
set timeoutlen=5000

"Editing Code
set ideajoin
nnoremap <leader>/ :action CommentByLineComment<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>w :w<CR>

nnoremap [[ :action MethodUp<CR>
nnoremap ]] :action MethodDown<CR>

inoremap <a-j> <DOWN>
inoremap <a-k> <UP>
inoremap <a-h> <LEFT>
inoremap <a-l> <RIGHT>


"File Explore
set NERDTree
nnoremap <leader>e :NERDTreeFocus<CR>

"LSP
nnoremap <leader>lf :action ReformatCode<CR>
nnoremap <leader>lq :action Refactorings.QuickListPopupAction<CR>
nnoremap <leader>lo :action OptimizeImports<CR>
nnoremap <leader>lr :action RenameElement<CR>
nnoremap <leader>la :action ShowIntentionActions<CR>

"goto
nnoremap gc :action GotoClass<CR>
nnoremap gi :action GotoImplementation<CR>
nnoremap gd :action GotoDeclaration<CR>
nnoremap gs :action GotoSuperMethod<CR>
nnoremap gt :action GotoTest<CR>
nnoremap gb :action Back<CR>
nnoremap gf :action Forward<CR>



"Debugging and Run
nnoremap <leader>rs :action ContextRun<CR>
" -run current file
nnoremap <leader>rc :action RunClass<CR> 
nnoremap <leader>rf :action ChooseRunConfiguration<CR>
nnoremap <leader>ru :action ActivateRunToolWindow<CR>


nnoremap <leader>dt :action ToggleLineBreakpoint<CR>
nnoremap <leader>ds :action ContextDebug<CR>
nnoremap <leader>du :action ActivateDebugToolWindow<CR>
nnoremap <leader>db :action ViewBreakpoints<CR>
nnoremap <leader>df :action ChooseDebugConfiguration<CR>

" File Navigation
nnoremap <leader>ff :action GotoFile<CR>
nnoremap <leader>fr :action RecentFiles<CR>
nnoremap <leader>fg :action FindInPath<CR>
nnoremap <leader>fp :action ManageRecentProjects<CR>
nnoremap <leader>fm :action MainMenu<CR>


"Git (TODO)




