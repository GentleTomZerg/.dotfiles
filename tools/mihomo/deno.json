{
  "imports": {
    "@eemeli/yaml": "jsr:@eemeli/yaml@2.9.1",
    "@std/assert": "jsr:@std/assert@1",
    "node:process": "./src/shims/node_process.ts"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check && deno task test",
    "test": "deno test --ignore=tests/parity_test.ts,tests/gate_test.ts",
    "parity": "deno test --allow-read --allow-run --allow-env tests/parity_test.ts",
    "gate": "deno test --allow-read --allow-write --allow-run tests/gate_test.ts"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
