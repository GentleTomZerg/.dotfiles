# ---------------------------------------------------------------------------
# provider-lift.example.yq — what to lift out of a provider document
# ---------------------------------------------------------------------------
#
# Copy this file to user/provider-lift.yq and edit the copy: that program is what
# decides which keys of a provider document end up in the overlay. This file is
# only the example — and render_config refuses to start until the copy exists, so
# the missing-copy failure is loud rather than silent.
#
# mihomo's proxy-providers read only `proxies:` out of a provider document
# (adapter/provider/provider.go: ProxySchema), so a subscription's own `dns:` is
# discarded even when it ships a full Clash config. This program turns that full
# config into the small overlay render_config merges LAST.
#
#   in : one provider cache document, e.g. proxy_providers/airport-1.yaml
#   out: the overlay, or `{}` when there is nothing to lift
#
#   dns.nameserver     -> dns.nameserver   (the airport's resolver becomes ours:
#                                           all DNS goes to it, not just nodes)
#   dns.use-hosts      -> dns.use-hosts
#   dns.fake-ip-filter -> dns.fake-ip-filter
#   hosts              -> hosts, if a provider ships one
#
# Never read, on purpose — take any of them only if you mean it:
#   enable, enhanced-mode, fake-ip-range  already decided by base.yaml
#   listen                                would open a LAN DNS listener
#   default-nameserver                    only bootstraps resolving the
#                                         resolver's own hostname, and
#                                         base.yaml's tls:// entries beat
#                                         the airport's plaintext ones
#
# To lift nothing, replace the program below with:
#   . as $sub | {}
#
# Run a copy by hand:
#   yq --from-file user/provider-lift.yq proxy_providers/airport-1.yaml
# ---------------------------------------------------------------------------

. as $sub
| [$sub.dns.nameserver[]?] as $ns
| {
    "dns": {
      # null when empty, never []: an empty array would REPLACE base.yaml's
      # committed nameserver on merge. The null is dropped below instead.
      "nameserver": (if ($ns | length) > 0 then ($ns | unique) else null end),
      "use-hosts": $sub.dns."use-hosts",
      "fake-ip-filter": $sub.dns."fake-ip-filter"
    },
    "hosts": $sub.hosts
  }

# A null would clobber base's key too (e.g. `hosts: null`), so drop them.
| (.dns |= with_entries(select(.value != null)))
| with_entries(select(.value != null))
# An empty map merges as a no-op, but drop it so "did we lift anything?" stays honest.
| if (.dns | length) == 0 then del(.dns) else . end
