# ---------------------------------------------------------------------------
# provider-lift.example.yq — which keys of a provider document become the overlay
# ---------------------------------------------------------------------------
#
# Seeded to user/provider-lift.yq; startproxy refuses to run without that copy.
#
#   in : one provider cache document, e.g. proxy_providers/airport-1.yaml
#   out: the overlay, or `{}` when there is nothing to lift
#   lifted : dns.nameserver, dns.use-hosts, dns.fake-ip-filter, hosts
#   never  : enable, enhanced-mode, fake-ip-range, listen, default-nameserver —
#            base.yaml already decided these, and base's tls:// resolvers beat the
#            airport's plaintext ones. Trade-off: README.md §DNS.
#
# Lift nothing:  replace the program below with `. as $sub | {}`
# Run by hand:   yq --from-file user/provider-lift.yq proxy_providers/airport-1.yaml
# ---------------------------------------------------------------------------

. as $sub
| [$sub.dns.nameserver[]?] as $ns
| {
    "dns": {
      # null, not []: [] would REPLACE base.yaml's nameserver on merge.
      "nameserver": (if ($ns | length) > 0 then ($ns | unique) else null end),
      "use-hosts": $sub.dns."use-hosts",
      "fake-ip-filter": $sub.dns."fake-ip-filter"
    },
    "hosts": $sub.hosts
  }

# Drop nulls: they would clobber base's key too (e.g. `hosts: null`).
| (.dns |= with_entries(select(.value != null)))
| with_entries(select(.value != null))
# Drop an empty map: it merges as a no-op, but "did we lift anything?" stays honest.
| if (.dns | length) == 0 then del(.dns) else . end
