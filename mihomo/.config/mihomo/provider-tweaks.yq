# ---------------------------------------------------------------------------
# provider-tweaks.yq — what may be lifted out of a subscription's `dns:` block
# ---------------------------------------------------------------------------
#
# mihomo's proxy-providers read only `proxies:` out of a provider document
# (adapter/provider/provider.go: ProxySchema), so the airport's own `dns:` is
# discarded even when the subscription ships a full Clash config. This program
# turns that full config into the small overlay `render_config` merges LAST.
#
#   in : one provider cache document, e.g. proxy_providers/e-ix.yaml
#   out: the overlay, plus a `_skipped` list the caller reports and deletes
#
# What passes, and what it becomes:
#
#   dns.nameserver              -> dns.proxy-server-nameserver   (RENAMED)
#   dns.use-hosts               -> dns.use-hosts
#   dns.fake-ip-filter          -> dns.fake-ip-filter
#   dns.proxy-server-nameserver -> same key, if a provider ships one
#   hosts                       -> hosts, if a provider ships one
#
# The rename is the whole point. `dns.nameserver` is the airport's GENERAL
# resolver; left under that name it would route all of your DNS through the
# airport. As `proxy-server-nameserver` it is consulted only for proxy-server
# hostnames (hub/executor/executor.go installs it as ProxyServerHostResolver),
# which is exactly the node domains public DNS cannot resolve.
#
# Never read, on purpose:
#   enable, enhanced-mode, fake-ip-range  already decided by mihomo.yaml
#   listen                                would open a LAN DNS listener
#   default-nameserver                    only bootstraps resolving the
#                                         resolver's own hostname, and
#                                         mihomo.yaml's tls:// entries beat
#                                         the airport's plaintext ones
#
# Run it by hand:
#   yq --from-file provider-tweaks.yq proxy_providers/e-ix.yaml
# ---------------------------------------------------------------------------

. as $sub

# Every nameserver the provider offers, from either key, in provider order.
| [$sub.dns."proxy-server-nameserver"[]?, $sub.dns.nameserver[]?] as $candidates

# A nameserver is usable here only if it does not route its own lookup through a
# proxy or interface: inside proxy-server-nameserver, `#RULES`, `#<proxy>` and
# `#<interface>` are circular — the resolver would need the very proxy it is
# resolving for. A `#key=value` parameter (skip-cert-verify, ecs, ...) is not
# circular and is kept. So: the part after `#` must contain an `=` and must not
# be RULES. (This yq build has no `def`, hence the predicate written out twice.)
| [$candidates[] | select(. as $s
    | if ($s | test("#") | not) then true
      else ($s | split("#")[1] | split("&")[0]) as $head
        | (($head != "RULES") and ($head | test("=")))
      end)] as $keep
| [$candidates[] | select((. as $s
    | if ($s | test("#") | not) then true
      else ($s | split("#")[1] | split("&")[0]) as $head
        | (($head != "RULES") and ($head | test("=")))
      end) | not)] as $skip

| {
    "dns": {
      # null when empty, never []: an empty array would REPLACE mihomo.yaml's
      # committed fallback instead of leaving it alone — arrays overwrite on
      # merge, maps merge key by key.
      "proxy-server-nameserver": (if ($keep | length) > 0 then ($keep | unique) else null end),
      "use-hosts": $sub.dns."use-hosts",
      "fake-ip-filter": $sub.dns."fake-ip-filter"
    },
    "hosts": $sub.hosts,
    "_skipped": $skip
  }

# A null would clobber the template's key too (e.g. `hosts: null`), so drop them.
| (.dns |= with_entries(select(.value != null)))
| with_entries(select(.value != null))
# An empty map merges as a no-op, but drop it so "did we lift anything?" stays honest.
| if (.dns | length) == 0 then del(.dns) else . end
| if (._skipped | length) == 0 then del(._skipped) else . end
