/neovim/.config/nvim/lazy-lock.json
# ignore all dirs under dic but preserve files
/stardict/.stardict/dic/*/
# ignore yazi plugin files
/yazi/.config/yazi/plugins/
/yazi/.config/yazi/flavors/
/yazi/.config/yazi/package.toml
# ignore mihomo related files
/mihomo/.config/mihomo/cache.db
/mihomo/.config/mihomo/external-ui/
/mihomo/.config/mihomo/mihomo_runtime.yaml
/mihomo/.config/mihomo/providers.yaml
/mihomo/.config/mihomo/proxy_providers/
/mihomo/.config/mihomo/ui/
/mihomo/.config/mihomo/rules/
# pi - auto-generated files (not managed by stow)
/pi/.pi/agent/npm/node_modules/
/pi/.pi/agent/npm/package-lock.json
/pi/.pi/agent/npm/.gitignore
/pi/.pi/agent/npm/package.json
/pi/.pi/agent/sessions/
/pi/.pi/agent/auth.json
/pi/.pi/context-mode/
/.pi-subagents/
