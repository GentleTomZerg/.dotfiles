{
  // General Settings
  "layer": "top",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,
  // Load Modules
  "include": [
    // "~/.config/ml4w/settings/waybar-quicklinks.json",
    "~/.config/waybar/modules.jsonc",
  ],
  // Modules Left
  "modules-left": ["hyprland/workspaces", "group/hardware", "bluetooth"],
  // Modules Center
  "modules-center": ["hyprland/window", "custom/empty"],
  // Modules Right
  "modules-right": ["group/audiolight", "group/batnet", "tray", "clock"],
}
