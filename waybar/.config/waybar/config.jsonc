{
  // General Settings
  "layer": "top",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,
  // Load Modules
  "include": [
    // "~/.config/ml4w/settings/waybar-quicklinks.json",
    "~/.config/waybar/modules.jsonc",
  ],
  // Modules Left
  "modules-left": [
    // "keyboard-state",
    "hyprland/workspaces",
    "group/hardware",
    "bluetooth",
    "custom/clash",
    "pulseaudio",
  ],
  // Modules Center
  "modules-center": [
    "hyprland/window"
  ],
  // Modules Right
  "modules-right": [
    "group/batnet",
    "tray",
    "clock"
  ],
}
